<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>Private Notes</title>
  <style>
    :root { color-scheme: dark; font: 16px system-ui, sans-serif; }
    body { max-width: 760px; margin: 0 auto; padding: 2rem 1rem; background: #111827; color: #f9fafb; }
    main { background: #1f2937; border-radius: 12px; padding: 1.25rem; }
    input, textarea, button { box-sizing: border-box; width: 100%; padding: .7rem; border-radius: 7px; border: 1px solid #4b5563; font: inherit; }
    input, textarea { background: #111827; color: inherit; }
    textarea { min-height: 300px; resize: vertical; }
    button { margin-top: 1rem; background: #2563eb; color: white; border: 0; cursor: pointer; font-weight: 700; }
    button.secondary { background: #374151; }
    .hidden { display: none; }
    .status { min-height: 1.4em; margin-top: .8rem; color: #fbbf24; }
    .small { color: #9ca3af; font-size: .9rem; }
  </style>
</head>
<body>
  <main>
    <h1>Private Notes</h1>
    <p class="small">Your password unlocks notes locally. It is never stored or sent anywhere.</p>

    <section id="login">
      <label for="password">Access password</label>
      <input id="password" type="password" autocomplete="current-password" required>
      <button id="unlock">Unlock</button>
    </section>

    <section id="editor" class="hidden">
      <label for="notes">Notes</label>
      <textarea id="notes" spellcheck="false" autocomplete="off"></textarea>
      <button id="save">Encrypt and save</button>
      <button id="lock" class="secondary">Lock</button>
    </section>

    <div id="status" class="status" role="status" aria-live="polite"></div>
  </main>

  <script>
    'use strict';

    const STORAGE_KEY = 'private-notes-v1';
    const ITERATIONS = 600000;
    const encoder = new TextEncoder();
    const decoder = new TextDecoder();
    const $ = (id) => document.getElementById(id);
    let password = '';

    function bytesToBase64(bytes) {
      let binary = '';
      for (const byte of bytes) binary += String.fromCharCode(byte);
      return btoa(binary);
    }

    function base64ToBytes(value) {
      const binary = atob(value);
      return Uint8Array.from(binary, (char) => char.charCodeAt(0));
    }

    async function deriveKey(secret, salt) {
      const material = await crypto.subtle.importKey(
        'raw',
        encoder.encode(secret),
        'PBKDF2',
        false,
        ['deriveKey']
      );

      return crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt,
          iterations: ITERATIONS,
          hash: 'SHA-256'
        },
        material,
        {
          name: 'AES-GCM',
          length: 256
        },
        false,
        ['encrypt', 'decrypt']
      );
    }

    async function encrypt(text, secret) {
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKey(secret, salt);

      const ciphertext = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        encoder.encode(text)
      );

      return JSON.stringify({
        version: 1,
        iterations: ITERATIONS,
        salt: bytesToBase64(salt),
        iv: bytesToBase64(iv),
        ciphertext: bytesToBase64(new Uint8Array(ciphertext))
      });
    }

    async function decrypt(record, secret) {
      const data = JSON.parse(record);

      if (data.version !== 1 || data.iterations !== ITERATIONS) {
        throw new Error('Unsupported encrypted data');
      }

      const key = await deriveKey(
        secret,
        base64ToBytes(data.salt)
      );

      const plaintext = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: base64ToBytes(data.iv) },
        key,
        base64ToBytes(data.ciphertext)
      );

      return decoder.decode(plaintext);
    }

    function setStatus(message) {
      $('status').textContent = message;
    }

    $('unlock').addEventListener('click', async () => {
      const candidate = $('password').value;

      if (!candidate) {
        setStatus('Enter a password.');
        return;
      }

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        const text = saved ? await decrypt(saved, candidate) : '';

        password = candidate;
        $('notes').value = text;
        $('password').value = '';

        $('login').classList.add('hidden');
        $('editor').classList.remove('hidden');

        setStatus(saved ? 'Unlocked.' : 'Create your first encrypted note.');
      } catch {
        setStatus('Incorrect password or damaged encrypted data.');
      }
    });

    $('save').addEventListener('click', async () => {
      try {
        const encrypted = await encrypt($('notes').value, password);
        localStorage.setItem(STORAGE_KEY, encrypted);
        setStatus('Encrypted and saved on this device.');
      } catch {
        setStatus('Could not save the encrypted note.');
      }
    });

    $('lock').addEventListener('click', () => {
      password = '';
      $('notes').value = '';
      $('editor').classList.add('hidden');
      $('login').classList.remove('hidden');
      setStatus('Locked.');
    });
  </script>
</body>
</html>
